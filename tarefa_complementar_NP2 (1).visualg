algoritmo "InsertionSort TAREFA COMPLEMENTAR NP2"
var
   v: vetor[1..10] de inteiro
   i, j, chave: inteiro
   achou: logico
inicio
   para i de 1 ate 10 faca
      escreva("Digite um numero: ")
      leia(v[i])
   fimpara

   para i de 2 ate 10 faca
      chave <- v[i]
      j <- i - 1
      achou <- falso
      enquanto (j >= 1) e (achou = falso) faca
         se v[j] > chave entao
            v[j + 1] <- v[j]
            j <- j - 1
         senao
            achou <- verdadeiro
         fimse
      fimenquanto
      v[j + 1] <- chave
   fimpara

   escreval("Vetor ordenado:")
   para i de 1 ate 10 faca
      escreva(v[i], " ")
   fimpara
fimalgoritmo