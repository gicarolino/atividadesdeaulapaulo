Algoritmo "InsertionSort TAREFA COMPLEMENTAR NP2"
Var
   v: vetor[1..10] de inteiro
   i, j, chave: inteiro
Inicio
   para i de 1 ate 10 faca
      escreva("Digite um numero: ")
      leia(v[i])
   fimpara

   para i de 2 ate 10 faca
      chave <- v[i]
      j <- i - 1
      enquanto j >= 1 faca
         se v[j] > chave entao
            v[j + 1] <- v[j]
            j <- j - 1
         senao
            interrompa
         fimse
      fimenquanto
      v[j + 1] <- chave
   fimpara

   escreval("Vetor ordenado:")
   para i de 1 ate 10 faca
      escreva(v[i], " ")
   fimpara
Fimalgoritmo